#requires -Version 7.0
<#
.SYNOPSIS
    Valida e constroi o Front-end; publica no Harbor somente com -Publish.
.DESCRIPTION
    latest = homologacao; stable = producao.
    -SomenteEnv e alias de -DryRun: nao altera .env, nao constroi, nao publica.
    Configuracao privada/segredos devem ser injetados em runtime pela infraestrutura.
#>
[CmdletBinding()]
param(
    [Parameter(Mandatory)][ValidateSet('latest', 'stable')][string]$Tag,
    [Alias('SomenteEnv')][switch]$DryRun,
    [switch]$Publish,
    [string]$PublicConfig
)
$ErrorActionPreference = 'Stop'
$repository = '__REPOSITORY__'
$dockerfileName = '__DOCKERFILE__'
$image = "${repository}:$Tag"
$environmentName = if ($Tag -eq 'stable') { 'producao' } else { 'homologacao' }
if ($DryRun -and $Publish) { throw 'DryRun/SomenteEnv e Publish sao mutuamente exclusivos.' }

Push-Location $PSScriptRoot
try {
    $package = Get-Content -Raw -LiteralPath 'package.json' | ConvertFrom-Json
    foreach ($scriptName in @('test', 'typecheck', 'lint', 'build')) {
        if (-not $package.scripts.$scriptName) { throw "Script npm obrigatorio ausente: $scriptName" }
    }
    if (-not (Test-Path -LiteralPath 'package-lock.json')) { throw 'package-lock.json obrigatorio para npm ci.' }
    $dockerText = Get-Content -Raw -LiteralPath $dockerfileName
    foreach ($stage in @('validation', 'runtime')) {
        if ($dockerText -notmatch ('(?im)^\s*FROM\s+[^\r\n]+\s+AS\s+' + $stage + '\s*(?:#.*)?$')) { throw "Estagio Docker ausente: $stage" }
    }
    # Dockerfile-specific ignore files take precedence over the root ignore.
    $ignoreName = if (Test-Path -LiteralPath "$dockerfileName.dockerignore") { "$dockerfileName.dockerignore" } else { '.dockerignore' }
    if (-not (Test-Path -LiteralPath $ignoreName)) { throw 'Arquivo dockerignore ausente.' }
    $ignoreLines = @(Get-Content -LiteralPath $ignoreName | ForEach-Object { $_.Trim() } | Where-Object { $_ -and -not $_.StartsWith('#') })
    foreach ($requiredPattern in @('.env', '.env.*', '.git')) {
        if ($requiredPattern -notin $ignoreLines) { throw "$ignoreName precisa excluir explicitamente $requiredPattern" }
    }
    if (@($ignoreLines | Where-Object { $_.StartsWith('!') -and $_ -ne '!.env.example' }).Count -gt 0) {
        throw 'Reinclusoes no dockerignore exigem revisao manual; este fluxo admite somente !.env.example.'
    }
    $buildArgs = @('--build-arg', "AMBIENTE=$environmentName")
    $publicKeys = @()
    if ($PublicConfig) {
        $config = Get-Content -Raw -LiteralPath $PublicConfig | ConvertFrom-Json -AsHashtable
        if ($config -isnot [System.Collections.IDictionary] -or -not $config.ContainsKey($Tag) -or $config[$Tag] -isnot [System.Collections.IDictionary]) {
            throw 'PublicConfig deve conter objeto latest ou stable correspondente a Tag.'
        }
        foreach ($key in $config[$Tag].Keys) {
            if ($key -notmatch '^NEXT_PUBLIC_[A-Z0-9_]+$' -or $key -match '(SECRET|PASSWORD|TOKEN|PRIVATE|CREDENTIAL|API_KEY)') {
                throw "Chave nao permitida em build publico: $key"
            }
            $value = $config[$Tag][$key]
            if ($value -isnot [string] -or $value -match '[\r\n\x00]') { throw "Valor publico invalido para $key" }
            $publicKeys += $key
            $buildArgs += @('--build-arg', "$key=$value")
        }
    }
    Write-Host "[deploy] Destino: $image; ambiente: $environmentName"
    Write-Host "[deploy] Nomes de argumentos publicos: AMBIENTE $($publicKeys -join ' ')"
    if ($DryRun) {
        Write-Host '[deploy] Previa concluida. Nenhuma .env alterada; nenhum build/push executado.'
        return
    }
    Get-Command docker -ErrorAction Stop | Out-Null
    # validation must execute the required checks in the container, with the lockfile.
    & docker build --file $dockerfileName --target validation @buildArgs -t "$image-validation" .
    if ($LASTEXITCODE -ne 0) { throw "Validacao Docker falhou (exit $LASTEXITCODE)." }
    # runtime must consume the artifacts from validation, as documented.
    & docker build --file $dockerfileName --target runtime @buildArgs -t $image .
    if ($LASTEXITCODE -ne 0) { throw "Build Docker falhou (exit $LASTEXITCODE)." }
    if ($Publish) {
        & docker push $image
        if ($LASTEXITCODE -ne 0) { throw "Push Docker falhou (exit $LASTEXITCODE)." }
        Write-Host "[deploy] Imagem publicada: $image. Atualizacao do servidor depende do fluxo DevOps."
    } else {
        Write-Host "[deploy] Imagem local pronta: $image. Use -Publish quando a publicacao estiver autorizada."
    }
} finally {
    Pop-Location
}
